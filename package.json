  "scripts": {
    "prestart": "node scripts/generate-runtime-env.js",
    "start": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze",
    "build:check": "npm run build && node scripts/bundleCheck.mjs",
    "serve": "vite preview",
    "generate:icon-catalog": "node scripts/generateIconCatalog.mjs",
    "prestorybook": "npm run generate:icon-catalog",
    "storybook": "storybook dev -p 6006",
    "typecheck:storybook": "tsc --noEmit --project tsconfig.storybook.json",
    "prebuild-storybook": "npm run generate:icon-catalog && npm run typecheck:storybook",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:formatting",
    "lint:css": "stylelint \"src/**/*.(s(c|a)ss|css|less)\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.(s(c|a)ss|css|less)\"",
    "lint:js": "eslint",
    "lint:formatting": "prettier . --check --ignore-unknown",
    "lint:formatting:fix": "prettier . --write --ignore-unknown",
    "prettier:css": "prettier **/*.scss --write ",
    "test:integration": "cypress open",
    "test:integration:cli": "concurrently --kill-others --success first \"cross-env BROWSER=none VITE_PORT=9000 VITE_USE_API_URL=true VITE_USE_HTTPS=true VITE_API_URL=api.oriso.org VITE_APP_URL=app.oriso.org VITE_MATRIX_URL=matrix.oriso.org VITE_KEYCLOAK_URL=https://auth.oriso.org VITE_KEYCLOAK_REALM=online-beratung VITE_KEYCLOAK_CLIENT_ID=app VITE_CSRF_WHITELIST_HEADER_FOR_LOCAL_DEVELOPMENT=X-CSRF-Token npm run start -- --strictPort\" \"wait-on http://localhost:9000/admin && cypress run\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
