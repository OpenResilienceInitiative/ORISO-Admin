  "scripts": {
    "prestart": "node scripts/generate-runtime-env.js",
    "start": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze",
    "build:check": "npm run build && node scripts/bundleCheck.mjs",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "yarn run lint:css && yarn run lint:js && yarn run lint:formatting",
    "lint:css": "stylelint --fix \"src/**/*.(s(c|a)ss|css|less)\"",
    "lint:js": "eslint",
    "lint:formatting": "prettier . --write --ignore-unknown --check",
    "prettier:css": "prettier **/*.scss --write ",
    "test:integration": "cypress open",
    "test:integration:cli": "concurrently --kill-others --success first \"cross-env BROWSER=none yarn run start\" \"wait-on http://localhost:9000/admin && cypress run\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
