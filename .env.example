# ORISO-Admin environment configuration
#
# Local development:
#   1. Copy this file to `.env`
#   2. Use the DEV values below
#   3. Run `npm install --legacy-peer-deps` and `npm run start`
#
# Production / Kubernetes:
#   - Option A (build-time): set VITE_* vars before `npm run build`
#   - Option B (runtime, recommended): inject pod env vars; container entrypoint
#     generates `/admin/env.js` from VITE_* / REACT_APP_* at startup
#
# Host values may be written with or without protocol (https:// is added when USE_HTTPS=true).
# Auth/login token uses {VITE_KEYCLOAK_URL}/realms/{VITE_KEYCLOAK_REALM}/...
# If VITE_KEYCLOAK_URL is unset, it falls back to {VITE_API_URL}/auth/realms/{VITE_KEYCLOAK_REALM}/...

# --- Shared ---
VITE_PORT=9000
BROWSER=none
VITE_USE_API_URL=true
VITE_USE_HTTPS=true
VITE_KEYCLOAK_URL=https://auth.example.org
VITE_KEYCLOAK_REALM=online-beratung
VITE_KEYCLOAK_CLIENT_ID=app
VITE_CSRF_WHITELIST_HEADER_FOR_LOCAL_DEVELOPMENT=X-CSRF-Token

# --- DEV (example hosts; use your environment) ---
VITE_API_URL=api.example.org
VITE_APP_URL=app.example.org
VITE_MATRIX_URL=matrix.example.org
VITE_COOKIE_DOMAIN=.example.org
VITE_COOKIE_SECURE=true

# Optional service-specific origins for mixed local/dev work.
# Leave unset to use VITE_API_URL/REACT_APP_API_URL for that service.
# Example: run only userservice locally while all other services use API ingress.
# VITE_USER_SERVICE_ORIGIN=http://localhost:8082
# VITE_AGENCY_SERVICE_ORIGIN=https://api.example.org
# VITE_TENANT_SERVICE_ORIGIN=https://api.example.org
# VITE_CONSULTING_TYPE_SERVICE_ORIGIN=https://api.example.org
# VITE_KEYCLOAK_ORIGIN=https://api.example.org

# --- PROD example ---
# VITE_API_URL=api.example.net
# VITE_APP_URL=app.example.net
# VITE_MATRIX_URL=matrix.example.net
# VITE_COOKIE_DOMAIN=.example.net
# VITE_COOKIE_SECURE=true

# --- Optional ---
# VITE_COOKIES_ALLOWEDLIST=

# DevOps / legacy CRA-style names are also supported at runtime via env.js:
# REACT_APP_API_URL, REACT_APP_MATRIX_URL, REACT_APP_APP_URL,
# REACT_APP_USER_SERVICE_ORIGIN, REACT_APP_AGENCY_SERVICE_ORIGIN,
# REACT_APP_TENANT_SERVICE_ORIGIN, REACT_APP_CONSULTING_TYPE_SERVICE_ORIGIN,
# REACT_APP_KEYCLOAK_ORIGIN
