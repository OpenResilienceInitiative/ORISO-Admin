{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-svgr/client", "node", "react", "react-dom"],
    "jsx": "react-jsx"
  },
  "include": [
    "index.d.ts",
    "vite-env.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "exclude": ["node_modules"]
}
