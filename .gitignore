# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
cypress/videos/
cypress/screenshots/
cypress.env.json

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.idea/
.history

.env
graphify-out/*

# Generated at container start by scripts/generate-runtime-env.js — never commit personal configs here
public/env.js
storybook-static

# local testing notes (contains credentials) — never commit
TESTING-CONTEXT.md

# Agent/local docs: existing tracked files stay tracked; new scratch under docs/ is ignored.
# Commit a task trail by adding a negation for that folder (see Frontend gitignore).
docs/*
!docs/agent-tasks/
docs/agent-tasks/*
!docs/agent-tasks/index.md
